# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo accounts (optional overrides; defaults are shown on the login page)
DEMO_FOUNDER_EMAIL=founder@practoforanimals.demo
DEMO_FOUNDER_PASSWORD=CareFirst2026!
DEMO_ADMIN_EMAIL=admin@practoforanimals.demo
DEMO_ADMIN_PASSWORD=StudioAdmin2026!

# -----------------------------------------------------------------------------
# Supabase (production persistence + auth)
# The app runs with a local demo data adapter when these are absent.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# n8n automation (optional)
# -----------------------------------------------------------------------------
N8N_CONTENT_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Canva (optional manual template link)
# -----------------------------------------------------------------------------
CANVA_TEMPLATE_URL=
